<svg xmlns="http://www.w3.org/2000/svg" width="640" height="960" viewBox="0 0 640 960" role="img" aria-label="Resident Evil 4 Remake cover illustration">
  <defs>
    <linearGradient id="re-bg" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#1d1f26"/>
      <stop offset="50%" stop-color="#0b0e13"/>
      <stop offset="100%" stop-color="#04070b"/>
    </linearGradient>
    <radialGradient id="re-fog" cx="70%" cy="40%" r="45%">
      <stop offset="0%" stop-color="#4d535d" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#04070b" stop-opacity="0"/>
    </radialGradient>
    <filter id="re-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#000" flood-opacity="0.6"/>
    </filter>
  </defs>
  <rect width="640" height="960" fill="url(#re-bg)"/>
  <rect width="640" height="180" fill="#f5f7ff"/>
  <text x="40" y="130" font-family="'Segoe UI', 'Helvetica', sans-serif" font-size="72" font-weight="700" fill="#111">PS5</text>
  <rect x="30" y="170" width="580" height="10" fill="#0f1a3d"/>
  <rect width="640" height="960" fill="url(#re-fog)"/>
  <g filter="url(#re-shadow)">
    <path d="M260 360 q-30 110 -5 210 q75 55 150 0 q15 -100 -40 -220 q-55 -30 -105 10z" fill="#6f7c84"/>
    <path d="M230 430 q-70 40 -65 130 q80 60 150 20 q-15 -90 -85 -150z" fill="#4a525a"/>
    <path d="M360 430 q65 -30 140 40 q-30 100 -125 90 q-50 -65 -15 -130z" fill="#353c45"/>
    <path d="M300 555 q-35 85 -15 120 q60 25 115 0 q5 -60 -55 -125 q-25 -10 -45 5z" fill="#0f1218"/>
    <path d="M320 380 q-30 -25 -65 -12 q-12 40 18 80 q30 -18 47 -68z" fill="#0f1218" opacity="0.85"/>
    <path d="M365 380 q28 -28 65 -12 q12 45 -18 80 q-32 -18 -47 -68z" fill="#0f1218" opacity="0.85"/>
  </g>
  <path d="M0 640 q140 -70 260 -40 q130 30 250 -55 v250 h-510 q-70 -70 0 -155z" fill="#141820" opacity="0.9"/>
  <text x="320" y="710" text-anchor="middle" font-family="'Bebas Neue', 'Impact', sans-serif" font-size="64" fill="#ffffff" letter-spacing="6">RESIDENT</text>
  <text x="320" y="765" text-anchor="middle" font-family="'Bebas Neue', 'Impact', sans-serif" font-size="64" fill="#c1121f" letter-spacing="6">EVIL</text>
  <text x="320" y="820" text-anchor="middle" font-family="'Bebas Neue', 'Impact', sans-serif" font-size="50" fill="#ffffff" letter-spacing="8">4 REMAKE</text>
  <rect x="70" y="860" width="230" height="70" rx="10" fill="#0c0f15" stroke="#5c6a78" stroke-width="4"/>
  <text x="185" y="905" text-anchor="middle" font-family="'Segoe UI', 'Helvetica', sans-serif" font-size="26" fill="#d7e0eb">TERROR</text>
  <rect x="360" y="860" width="220" height="70" rx="10" fill="#1d222c" stroke="#7f8a95" stroke-width="4"/>
  <text x="470" y="905" text-anchor="middle" font-family="'Segoe UI', 'Helvetica', sans-serif" font-size="26" fill="#e2e9f2">REIMAGINADO</text>
</svg>
