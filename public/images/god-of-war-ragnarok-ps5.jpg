<svg xmlns="http://www.w3.org/2000/svg" width="640" height="960" viewBox="0 0 640 960" role="img" aria-label="God of War Ragnarök cover illustration">
  <defs>
    <linearGradient id="gow-bg" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#d9e8f9"/>
      <stop offset="55%" stop-color="#5f87ad"/>
      <stop offset="100%" stop-color="#1c2f46"/>
    </linearGradient>
    <linearGradient id="gow-ice" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#bfe6ff"/>
      <stop offset="100%" stop-color="#8fb5d4"/>
    </linearGradient>
    <filter id="gow-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#0d1b2d" flood-opacity="0.55"/>
    </filter>
  </defs>
  <rect width="640" height="960" fill="url(#gow-bg)"/>
  <rect width="640" height="180" fill="#f5f7ff"/>
  <text x="40" y="130" font-family="'Segoe UI', 'Helvetica', sans-serif" font-size="72" font-weight="700" fill="#111">PS5</text>
  <rect x="30" y="170" width="580" height="10" fill="#0f1a3d"/>
  <rect x="0" y="640" width="640" height="160" fill="url(#gow-ice)"/>
  <path d="M0 640 q140 -70 260 -40 q130 30 250 -55 v215 h-510 q-70 -50 0 -120z" fill="#a4c8e4"/>
  <g filter="url(#gow-shadow)">
    <path d="M255 300 q-40 120 -10 250 q70 80 170 40 q55 -90 20 -220 q-40 -115 -180 -70z" fill="#3c4b60"/>
    <path d="M225 430 q-70 40 -70 130 q85 70 155 20 q-15 -90 -85 -150z" fill="#5d6c83"/>
    <path d="M370 430 q70 -35 140 35 q-25 90 -130 90 q-45 -65 -10 -125z" fill="#7b8ba5"/>
    <path d="M310 555 q-35 95 -10 135 q60 25 120 0 q5 -70 -55 -140 q-30 -12 -55 5z" fill="#1f2e44"/>
    <path d="M330 380 q-30 -25 -70 -10 q-10 40 20 80 q32 -20 50 -70z" fill="#1f2e44" opacity="0.85"/>
    <path d="M375 380 q30 -28 70 -10 q10 45 -20 80 q-35 -20 -50 -70z" fill="#1f2e44" opacity="0.85"/>
  </g>
  <text x="320" y="710" text-anchor="middle" font-family="'Cinzel', 'Trajan Pro', serif" font-size="72" fill="#e8f3ff" letter-spacing="4">GOD OF WAR</text>
  <text x="320" y="770" text-anchor="middle" font-family="'Cinzel', 'Trajan Pro', serif" font-size="58" fill="#e8f3ff" letter-spacing="8">RAGNARÖK</text>
  <text x="320" y="825" text-anchor="middle" font-family="'Segoe UI', 'Helvetica', sans-serif" font-size="26" fill="#d6e4f5" letter-spacing="3">KRATOS &amp; ATREUS</text>
  <rect x="70" y="860" width="220" height="70" rx="10" fill="#1c2f46" stroke="#b6cbe6" stroke-width="4"/>
  <text x="180" y="905" text-anchor="middle" font-family="'Segoe UI', 'Helvetica', sans-serif" font-size="28" fill="#e8f3ff">MITO NÓRDICO</text>
  <rect x="360" y="860" width="220" height="70" rx="10" fill="#3c4b60" stroke="#d5e6ff" stroke-width="4"/>
  <text x="470" y="905" text-anchor="middle" font-family="'Segoe UI', 'Helvetica', sans-serif" font-size="28" fill="#f5fbff">ACCIÓN ÉPICA</text>
</svg>
